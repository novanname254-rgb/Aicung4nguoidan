# ===================================================
# LifeCare Environment Variables
# ===================================================

# Port for local server (default: 3000)
PORT=3000

# Turso (libSQL) Cloud Database Configuration
# (Recommended for production & Vercel deployment)
# Support both TURSO_* and TURBO_* prefix
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: Demo user custom password
DEMO_USER_PASSWORD=LifeCare2026!
