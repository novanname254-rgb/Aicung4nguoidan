# ===================================================
# LifeCare – biến môi trường
# ===================================================

# Cổng chạy trên máy (mặc định 3000)
PORT=3000

# ---------------------------------------------------
# LƯU DỮ LIỆU: Google Sheet (khi deploy) hoặc file JSON (khi chạy trên máy)
# ---------------------------------------------------
# Có đủ 2 biến dưới đây thì dữ liệu lưu vào Google Sheet (mỗi bảng một tab).
# Thiếu thì lưu vào file JSON: data/lifecare-store.json (hoặc DATA_FILE).
GOOGLE_SHEET_ID=
# Nội dung file JSON của Service Account (dán nguyên JSON hoặc dạng base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
# DATA_FILE=data/lifecare-store.json

# Khoá mã hoá các trường nhạy cảm (email, họ tên, ngày sinh, ngày/giờ công việc,
# dữ liệu sức khoẻ & tâm trạng, lịch sử chat AI). BẮT BUỘC khi deploy.
# Tạo khoá: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MẤT KHOÁ = MẤT DỮ LIỆU. Không đổi khoá sau khi đã có dữ liệu.
DATA_ENCRYPTION_KEY=

# ---------------------------------------------------
# TRỢ LÝ AI (Groq). Không đặt key thì trợ lý dùng bộ luật trả lời cố định.
# Lấy key tại https://console.groq.com/keys
# ---------------------------------------------------
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Model dự phòng khi model chính hết hạn mức token/phút (Groq tính hạn mức riêng từng model).
# Đặt "none" để tắt.
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Múi giờ mặc định nếu trình duyệt không gửi (mặc định Asia/Ho_Chi_Minh)
# APP_TIMEZONE=Asia/Ho_Chi_Minh

# Tuỳ chọn: mật khẩu tài khoản demo
DEMO_USER_PASSWORD=LifeCare2026!

# Gửi email "Quên mật khẩu" (mật khẩu tạm thời). Với Gmail: bật xác minh 2 bước rồi tạo
# "Mật khẩu ứng dụng" (App Password 16 ký tự) tại https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=LifeCare <ten-email@gmail.com>
